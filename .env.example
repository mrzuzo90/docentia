# ==============================================================================
# DOCENTIA — CONFIGURACIÓN DE ENTORNO MULTI-PROVEEDOR
# ==============================================================================
# Proveedor por defecto: 'gemini' | 'deepseek' | 'openrouter' | 'openai' | 'local'
VITE_AI_PROVIDER=gemini

# 01. Google Gemini (Recomendado para visión multimodal de PDFs y escaneos de exámenes)
VITE_GEMINI_API_KEY=

# 02. DeepSeek (DeepSeek-V3 / DeepSeek-R1 para razonamiento curricular y STEM)
VITE_DEEPSEEK_API_KEY=

# 03. OpenRouter (Acceso unificado a Claude 3.5 Sonnet, GPT-4o, Llama 3.3, R1)
VITE_OPENROUTER_API_KEY=

# 04. OpenAI o Servidor Compatible (Ollama, vLLM, LMStudio)
VITE_OPENAI_API_KEY=
